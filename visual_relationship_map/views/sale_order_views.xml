                        icon="fa-sitemap"
                        context="{'active_model': 'stock.picking', 'active_id': id}"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move (Invoices) -->
    <record id="view_move_form_inherit_visual_map" model="ir.ui.view">
        <field name="name">account.move.form.inherit.visual.map</field>
        <field name="model">account.move</field>
