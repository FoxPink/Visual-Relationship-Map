<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Sale Order -->
    <record id="view_order_form_inherit_visual_map" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.visual.map</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(visual_relationship_map.action_visual_map)d" 
                        string="View Map" 
                        type="action" 
                        class="btn-secondary"
                        icon="fa-sitemap"
                        context="{'active_model': 'sale.order', 'active_id': id}"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order -->
    <record id="purchase_order_form_inherit_visual_map" model="ir.ui.view">
